    {"label":"com.ivogundlach.apple-mail-draft-runner","moduleID":"mail.assistant","executable":"Helpers/MailAssistant.app/Contents/MacOS/mail-assistant-runner","arguments":["--once"],"schedule":{"kind":"hourlyWindow","minute":0,"startHour":8,"endHour":22}},
    {"label":"com.ivogundlach.codex-mirror-sync","moduleID":"systems.codex-improvement","executable":"Modules/systems.codex-improvement/bin/codex-mirror-sync","arguments":[],"schedule":{"kind":"daily","hour":4,"minute":0}},
    {"label":"com.ivogundlach.memory-corpus-backup","moduleID":"systems.memory","executable":"Modules/systems.memory/bin/memory-corpus-backup","arguments":[],"schedule":{"kind":"daily","hour":4,"minute":0}},
