#!/usr/bin/env python3
"""memory-secret-scan — refuse to publish secrets from the memory corpus.

Used two ways:
  memory-secret-scan            scan every git-tracked file, report, exit 1 on any hit
  memory-secret-scan --staged   scan only staged files (the pre-commit hook path)

The corpus is pushed to a private GitHub remote. Private is not the same as safe:
a leaked token in git history survives file deletion, so the gate has to run
BEFORE the commit, not after. Patterns are the same set transcript_distill.py
redacts with, so what the distiller strips on the way in cannot slip out here.

Exit 0 clean, 1 findings, 2 usage/error. Findings print file:line and the
pattern name only — never the matched value.
"""
import re, subprocess, sys, os

# Left word-boundary guard on every prefix pattern. Without it `sk-` matches inside
# ordinary words: "ask-the-board" and "task-runner-configuration" both hit, which is
# how this scan's first run produced 14 false positives across the wiki and ledger.
_NB = r"(?<![A-Za-z0-9])"
PATTERNS = [
    ("provider-style key",         re.compile(_NB + r"sk-[A-Za-z0-9_\-]{16,}")),
    ("google api key",             re.compile(_NB + r"AIza[0-9A-Za-z_\-]{30,}")),
    ("github token",               re.compile(_NB + r"gh[pousr]_[A-Za-z0-9]{30,}")),
    ("slack token",                re.compile(_NB + r"xox[baprs]-[A-Za-z0-9\-]{10,}")),
    ("aws access key id",          re.compile(_NB + r"AKIA[0-9A-Z]{16}")),
    ("jwt",                        re.compile(_NB + r"eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{5,}")),
    ("bearer token",               re.compile(r"(?i)bearer\s+[A-Za-z0-9_\-\.=/+]{16,}")),
    # `value` is checked against is_literal_value(): this rule is a heuristic on
    # the SHAPE of an assignment, so it needs the assigned value to look real.
    # The optional quote after the keyword is what catches JSON and YAML, where the
    # KEY is quoted: `"client_secret": "…"` never reached this rule without it,
    # which is the single most common shape a real credential is stored in.
    ("assigned credential",        re.compile(r"(?i)(password|passwd|api[_-]?key|access[_-]?token|secret|auth[_-]?token)['\"]?\s*[:=]\s*['\"]?(?P<value>[^\s'\"]{8,})")),
    ("private key block",          re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
]

# The distiller writes this marker where it already removed something, and the
# scan itself plus the docs quote the pattern names — neither is a leak.
ALLOW_LINE = re.compile(r"\[REDACTED\]")
# Per-line escape hatch for a genuine false positive this file's rules cannot
# infer. Deliberately explicit and per-line: there is no path glob and no
# allowlist file, because a gate whose exemptions can be widened in bulk stops
# being a gate. Anything broader than one line is a decision for the user.
#
# The pragma names the rule it excuses — `secret-scan: allow github token`. A
# bare `secret-scan: allow` still works but excuses everything on the line, so a
# line exempted for one reason cannot silently start hiding a different kind of
# secret when it is edited later.
ALLOW_PRAGMA = re.compile(r"secret-scan:\s*allow(?P<rule>[^#\n]*)")

# Self-referential files: they contain the patterns BECAUSE they define them, so
# a hit here is the tool detecting itself.
#
# tests/test_redaction.py is deliberately NOT here, though it is the fixture
# corpus for these exact rules. Exempting a whole file makes it the one place in
# the corpus where a real key could be pasted — while debugging against a live
# credential, say — and never be seen again. Its fixtures carry per-line pragmas
# instead, which cost one line each and keep every other line in the file live.
SELF = {
    "tools/memory-secret-scan",
    "tools/transcript_distill.py",
}


def line_allows(line, rule):
    """True when this line carries a pragma excusing this rule."""
    for match in ALLOW_PRAGMA.finditer(line):
        named = match.group("rule").strip().casefold()
        if not named or named == rule.casefold():
            return True
    return False

# A credential ASSIGNMENT is only evidence of a leak when the assigned value is
# a literal. A getter call such as `get_password()` is the canonical false positive — it is
# how the code is supposed to look, and prose explaining that fact trips the same
# rule. Both cost the corpus its backup for four days in Aug 2026: 12 findings,
# all of them this, blocking every push while nothing was actually wrong.
#
# Note the asymmetry with redaction. transcript_distill.py SHOULD over-redact
# `get_password()` on the way in — masking a non-secret costs nothing there. Here
# the same over-match halts a backup, so the bar is different: this gate must fire
# on live-looking values, not on the shape of an assignment.
_EXPRESSION = re.compile(r"[()\[\]]")            # a call or subscript, not a literal
_INTERPOLATION = re.compile(r"^[\$<{%]|\{\{|%s|%\(")   # ${VAR}, <your-key>, {{tpl}}, %s
_PLACEHOLDER = re.compile(
    r"(?i)^(x{3,}|\.{3,}|-{3,}|_{3,}|none|null|true|false|changeme|your[_-]?\w+|"
    r"example\w*|placeholder|redacted|secret|password|dummy|test\w*|fake\w*|todo)$")


def is_literal_value(value):
    """Does the right-hand side of an assignment look like an actual secret?

    False for code expressions, template interpolations and placeholder words —
    each of which is proof the line is describing a credential rather than
    holding one.
    """
    value = value.strip().strip("'\"").rstrip("`,;")
    if not value:
        return False
    if _EXPRESSION.search(value) or _INTERPOLATION.search(value):
        return False
    return not _PLACEHOLDER.match(value)


def tracked_files(staged):
    cmd = (["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"]
           if staged else ["git", "ls-files"])
    out = subprocess.run(cmd, capture_output=True, text=True)
    if out.returncode != 0:
        print("memory-secret-scan: not a git repo (or git failed)", file=sys.stderr)
        raise SystemExit(2)
    return [f for f in out.stdout.splitlines() if f]


def main():
    staged = "--staged" in sys.argv[1:]
    if any(a in ("-h", "--help") for a in sys.argv[1:]):
        print(__doc__); return 0
    if any(a in ("--version", "-V") for a in sys.argv[1:]):
        print("memory-secret-scan (pre-publish secret gate for ~/.memory)"); return 0

    root = os.environ.get("MEMORY_ROOT", os.path.expanduser("~/.memory"))
    os.chdir(root)

    findings = []
    for rel in tracked_files(staged):
        if rel in SELF or not os.path.isfile(rel):
            continue
        try:
            text = open(rel, errors="ignore").read()
        except OSError:
            continue
        for lineno, line in enumerate(text.splitlines(), 1):
            if ALLOW_LINE.search(line):
                continue
            for name, rx in PATTERNS:
                if line_allows(line, name):
                    continue
                # finditer, not search: a line that describes the pattern and
                # also carries a real value must still be caught, so every match
                # on the line is judged rather than only the leftmost one.
                # Only the shape-based rule needs its value inspected; the
                # prefixed-token rules (sk-, AKIA, ghp_ …) already match a
                # credential format, not a phrase that mentions one.
                if any(
                    "value" not in (m.groupdict() or {})
                    or is_literal_value(m.group("value"))
                    for m in rx.finditer(line)
                ):
                    findings.append((rel, lineno, name))
                    break

    scope = "staged" if staged else "tracked"
    if findings:
        print(f"memory-secret-scan: {len(findings)} finding(s) in {scope} files — COMMIT BLOCKED")
        for rel, lineno, name in findings[:50]:
            print(f"  {rel}:{lineno}  [{name}]")
        if len(findings) > 50:
            print(f"  … and {len(findings) - 50} more")
        print("\nRedact the value (or add [REDACTED]) before committing.")
        return 1

    print(f"memory-secret-scan: clean ({len(tracked_files(staged))} {scope} file(s))")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
