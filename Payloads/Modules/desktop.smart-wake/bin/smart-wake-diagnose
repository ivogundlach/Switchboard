#!/bin/bash
set -u

NAME="smart-wake-diagnose"
VERSION="1.0.0"
CODE_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [ "${SMART_WAKE_DIAG_TEST_MODE:-0}" = "1" ]; then
    SMART_WAKE_HOME="${SMART_WAKE_DIAG_HOME:?SMART_WAKE_DIAG_HOME is required in test mode}"
    CODE_DIR="${SMART_WAKE_DIAG_SOURCE_HOME:?SMART_WAKE_DIAG_SOURCE_HOME is required in test mode}"
    HELPER="${SMART_WAKE_DIAG_HELPER:?SMART_WAKE_DIAG_HELPER is required in test mode}"
    LABEL="${SMART_WAKE_DIAG_LABEL:-com.user.smartwake.sleep-guard}"
else
    HOME_DIR="${HOME:-$(cd && pwd -P)}"
    SMART_WAKE_HOME="${SMART_WAKE_DIAG_HOME:-${HOME_DIR}/.config/smart-wake}"
    HELPER="/Library/PrivilegedHelperTools/com.user.smartwake.sleep-guard"
    LABEL="com.user.smartwake.sleep-guard"
fi
STATUS_FILE="${SMART_WAKE_HOME}/state/status.env"

REQUIRED_RUNTIME_FILES=(
    configure-display-lock.sh
    install-sleep-guard.sh
    lib.sh
    sleep-guard-root.sh
    smart-wake
    smart-wake.sh
    wifi-ssid.py
)

usage() {
    cat <<'EOF'
Usage: smart-wake-diagnose [--check|--help|--version]

Print a credential-safe Smart Wake health report. --check also runs the
deterministic regression checks. Credential contents and network names are
never read or printed.
EOF
}

case "${1:-}" in
    --version|-V)
        printf '%s %s\n' "$NAME" "$VERSION"
        exit 0
        ;;
    --help|-h)
        usage
        exit 0
        ;;
    --check|'') ;;
    *)
        printf 'Unknown argument: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

run_checks=false
[ "${1:-}" = "--check" ] && run_checks=true
failures=0

section() {
    printf '\n--- %s ---\n' "$1"
}

printf 'Smart Wake diagnostic report: %s\n' "$(/bin/date '+%Y-%m-%d %H:%M:%S %z')"

section "protected helper"
if [ -f "$HELPER" ]; then
    printf 'protected helper present: %s\n' "$HELPER"
else
    printf 'ERROR: protected helper is missing: %s\n' "$HELPER"
    failures=$((failures + 1))
fi
if helper_state=$(/bin/launchctl print "system/${LABEL}" 2>&1); then
    printf '%s\n' "$helper_state" | /usr/bin/awk '
        /^[[:space:]]*(state|pid|runs|last exit code|job state) =/ { print }
    '
    if ! printf '%s\n' "$helper_state" | /usr/bin/grep -q 'state = running'; then
        printf 'ERROR: protected helper is registered but not running\n'
        failures=$((failures + 1))
    fi
else
    printf 'ERROR: protected helper is unavailable\n'
    failures=$((failures + 1))
fi

section "power state"
/usr/bin/pmset -g | /usr/bin/grep -E 'SleepDisabled|^[[:space:]]*(sleep|displaysleep|networkoversleep)[[:space:]]' || true

section "Smart Wake decision"
if [ -f "$STATUS_FILE" ]; then
    /usr/bin/awk -F= '
        /^UPDATED_AT=/ { print "UPDATED_AT=[present]"; next }
        /^NOW=/ { if ($2 ~ /^[0-9]+$/) print; else print "NOW=[invalid]"; next }
        /^KEEP_AWAKE=/ { if ($2 ~ /^(true|false)$/) print; else print "KEEP_AWAKE=[invalid]"; next }
        /^REASON=/ { print "REASON=[redacted]"; next }
        /^MODE=/ { if ($2 ~ /^(ac|battery)$/) print; else print "MODE=[invalid]"; next }
        /^SSID=/ { print "SSID=[redacted]"; next }
        /^(TRUSTED_WIFI|AC_POWER)=/ { if ($2 ~ /^(true|false)$/) print; else print $1 "=[invalid]"; next }
        /^BATTERY_PERCENT=/ { if ($2 ~ /^[0-9]+$/) print; else print "BATTERY_PERCENT=[invalid]"; next }
        /^OVERRIDE_UNTIL=/ { print "OVERRIDE_UNTIL=[redacted]"; next }
        /^COOLDOWN_UNTIL=/ { print "COOLDOWN_UNTIL=[redacted]"; next }
    ' "$STATUS_FILE"
else
    printf 'ERROR: Smart Wake status file is missing\n'
    failures=$((failures + 1))
fi

section "bundled runtime"
for relative in "${REQUIRED_RUNTIME_FILES[@]}"; do
    runtime_path="${CODE_DIR}/${relative}"
    if [ -f "$runtime_path" ]; then
        printf 'present %s\n' "$relative"
    else
        printf 'ERROR: missing bundled runtime file %s\n' "$relative"
        failures=$((failures + 1))
    fi
done

section "credential-file metadata"
if [ -n "${SMART_WAKE_CREDENTIAL_PATHS:-}" ]; then
    IFS=':' read -r -a credential_paths <<< "$SMART_WAKE_CREDENTIAL_PATHS"
    for credential_path in "${credential_paths[@]}"; do
        [ -n "$credential_path" ] || continue
        if [ -f "$credential_path" ]; then
            /usr/bin/stat -f '%N mode=%Sp modified=%Sm size=%z' -t '%Y-%m-%d %H:%M:%S %z' "$credential_path"
        else
            printf 'ERROR: missing configured credential path %s\n' "$credential_path"
            failures=$((failures + 1))
        fi
    done
else
    printf 'credential metadata skipped (set SMART_WAKE_CREDENTIAL_PATHS to inspect configured files)\n'
fi

section "helper-log metadata"
for log_path in /var/log/smart-wake-sleep-guard.log /var/log/smart-wake-sleep-guard.err; do
    if [ -f "$log_path" ]; then
        /usr/bin/stat -f '%N modified=%Sm size=%z' -t '%Y-%m-%d %H:%M:%S %z' "$log_path"
    else
        printf 'missing %s\n' "$log_path"
    fi
done

if [ "$run_checks" = true ]; then
    section "regression checks"
    for relative in "${REQUIRED_RUNTIME_FILES[@]}"; do
        runtime_path="${CODE_DIR}/${relative}"
        case "$relative" in
            *.sh|smart-wake)
                if /bin/bash -n "$runtime_path" 2>&1; then
                    printf 'syntax ok %s\n' "$relative"
                else
                    printf 'ERROR: syntax check failed: %s\n' "$relative"
                    failures=$((failures + 1))
                fi
                ;;
            *.py)
                if /usr/bin/python3 - "$runtime_path" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
compile(path.read_text(), str(path), "exec")
PY
                then
                    printf 'syntax ok %s\n' "$relative"
                else
                    printf 'ERROR: syntax check failed: %s\n' "$relative"
                    failures=$((failures + 1))
                fi
                ;;
        esac
    done
fi

section "result"
if [ "$failures" -eq 0 ]; then
    printf 'Smart Wake health checks passed\n'
    exit 0
fi
printf 'Smart Wake health checks found %s failure(s)\n' "$failures"
exit 1
