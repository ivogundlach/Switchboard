    {"label":"com.ivogundlach.memory.semantic-index","moduleID":"systems.memory","executable":"Modules/systems.memory/bin/semantic-index-retry","arguments":["--semantic-only"],"schedule":{"kind":"daily","hour":4,"minute":0}},
    {"label":"com.ivogundlach.personal-repo-sync","moduleID":"systems.repository-release","executable":"Modules/systems.repository-release/bin/personal-repo-sync","arguments":[],"schedule":{"kind":"daily","hour":4,"minute":0}},
    {"label":"com.ivogundlach.quit-on-close","moduleID":"desktop.quit-on-close","executable":"Helpers/quit-on-close","arguments":[],"schedule":{"kind":"continuous"}},
    {"label":"com.ivogundlach.Kinetics","moduleID":"desktop.kinetics","executable":"Companions/Kinetics.app/Contents/MacOS/Kinetics","arguments":["--login"],"schedule":{"kind":"continuous"}},
